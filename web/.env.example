# ── Локально (SQLite) ──────────────────────────────────────────────
DATABASE_URL=file:./shakhmatka.db
PAYLOAD_SECRET=замените-на-длинную-случайную-строку
CONTENT_DIR=../content/articles
NEXT_PUBLIC_SITE_URL=https://шахматка.москва

# 1 — показывать на сайте только статьи со статусом ready
PUBLIC_ONLY_READY=
# 1 — открыть сайт для поисковиков (robots.txt). Только на боевом домене
PUBLIC_ROBOTS=

# ── Продакшен (Timeweb Cloud Apps): задаются в панели, не в файле ──
# DATABASE_URI=postgres://пользователь:пароль@хост:5432/база   — если задан, сайт работает на PostgreSQL
# DATABASE_SSL=1                                               — если база требует SSL
# S3_BUCKET=имя-бакета                                          — если задан, фото хранятся в S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# SEED_ON_START=1                                               — при старте импортировать контент из content/
